<page-meta page-style="{{ showSelectedFoodsPopup ? 'overflow: hidden;' : '' }}" />

<!-- 搜索栏 -->
<van-search value="{{ searchValue }}" shape="round" background="{{ themeColor }}" placeholder="搜索食物" bind:change="onSearch" bind:clear="onSearchClear" show-action="{{ !!searchValue }}" />

<!-- 主要内容区域 -->
<block wx:if="{{ !loading }}">
  <van-row wx:if="{{ filteredFoodData.length > 0 }}">
    <!-- 左侧分类栏 -->
    <van-col span="6">
      <van-sidebar active-key="{{ activeCategory }}" bind:change="onCategoryChange" active-color="{{ themeColor }}">
        <van-sidebar-item wx:for="{{ filteredFoodData }}" wx:key="id" title="{{ item.categoryName }}" />
      </van-sidebar>
    </van-col>

    <!-- 右侧食物列表 -->
    <van-col span="18">
      <van-divider contentPosition="center" customStyle="margin: 10px 0; color: {{ themeColor }}; border-color: {{ themeColor }};">
        {{ filteredFoodData[activeCategory].categoryName }}
      </van-divider>

      <van-cell-group>
        <van-cell wx:for="{{ filteredFoodData[activeCategory].foods }}" wx:key="id" center>
          <view slot="title">
            <van-row>
              <van-col span="8">
                <van-image width="65" height="65" fit="cover" radius="8" src="{{ item.icon }}" lazy-load />
              </van-col>
              <van-col span="6">
                <view class="food-name">{{ item.name }}</view>
                <van-tag plain color="{{ themeColor }}">含水{{ item.waterContent }}%</van-tag>
              </van-col>
              <van-col span="10">
                <view class="stepper-container">
                  <view class="stepper-label">克数</view>
                  <van-stepper value="{{ selectedFoods[item.id].weight || 0 }}" min="0" step="10" integer bind:change="onStepperChange" data-food-id="{{ item.id }}" data-food-name="{{ item.name }}" data-water-content="{{ item.waterContent }}" theme="round" button-size="30px" />
                </view>
              </van-col>
            </van-row>
          </view>
        </van-cell>
      </van-cell-group>
    </van-col>
  </van-row>

  <!-- 无搜索结果显示 -->
  <van-empty wx:if="{{ filteredFoodData.length === 0 }}" description="未找到相关食物" />
</block>

<!-- 浮动操作按钮 -->
<van-goods-action>
  <van-goods-action-icon icon="cart-o" text="已选食物" info="{{ selectedCount }}" bind:click="showSelectedFoods" />
  <van-goods-action-button text="计算含水量" color="{{ themeColor }}" bind:click="calculateTotal" />
</van-goods-action>

<!-- 已选食物抽屉面板 -->
<van-popup show="{{ showSelectedFoodsPopup }}" position="right" custom-style="width: 85%; height: 100%;" bind:close="onSelectedFoodsPopupClose" safe-area-inset-top="{{ true }}" round="{{ false }}">
  <view class="drawer-content">
    <view wx:if="{{ selectedFoodsList.length > 0 }}">
      <van-cell-group title="食物明细">
        <van-swipe-cell wx:for="{{ selectedFoodsList }}" wx:key="id" right-width="{{ 65 }}">
          <van-cell title="{{ item.name }}" label="含水{{ item.waterContent }}%" size="large">
            <view slot="right-icon" class="cell-value-section">
              <view class="food-weight">{{ item.weight }}g</view>
              <view class="food-water">{{ (item.weight * item.waterContent / 100) }}ml</view>
            </view>
          </van-cell>
          <view slot="right" class="delete-btn" catch:tap="removeFood" data-food-id="{{ item.id }}">删除</view>
        </van-swipe-cell>
      </van-cell-group>
    </view>

    <van-empty wx:else description="暂无已选食物" />
  </view>
</van-popup>

<!-- 结果弹窗 -->
<van-dialog id="van-dialog" confirm-button-color="{{ themeColor }}" />
<van-toast id="van-toast" />