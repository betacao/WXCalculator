.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #4fc08d 0%, #f8f8f8 300rpx);
  padding: 20rpx;
}

/* 未登录状态 */
.login-section {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}

.login-card {
  background: white;
  border-radius: 20rpx;
  padding: 80rpx 60rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.login-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.login-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.login-btn {
  background: #4fc08d;
  color: white;
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: none;
  font-size: 32rpx;
}

.login-btn::after {
  border: none;
}

/* 已登录状态 */
.profile-section {
  padding-top: 40rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 30rpx;
  border: 4rpx solid #f0f0f0;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.user-desc {
  font-size: 26rpx;
  color: #999;
}

.stats-section {
  display: flex;
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #4fc08d;
  margin-bottom: 12rpx;
}

.stats-label {
  font-size: 26rpx;
  color: #999;
}

.stats-divider {
  width: 2rpx;
  background-color: #f0f0f0;
  margin: 0 40rpx;
}

.menu-section {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 编辑资料弹窗 */
.edit-profile-container {
  padding: 40rpx 30rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.edit-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
  text-align: center;
}

.edit-item {
  margin-bottom: 40rpx;
}

.edit-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #f8f8f8;
  border-radius: 20rpx;
  padding: 40rpx;
  border: none;
}

.avatar-btn::after {
  border: none;
}

.edit-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 20rpx;
}

.avatar-tip {
  font-size: 24rpx;
  color: #999;
}

.nickname-input {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: #333;
}

.edit-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff8e1;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 40rpx;
  font-size: 24rpx;
  color: #ff9800;
}

.edit-actions {
  margin-top: 60rpx;
  margin-bottom: 0;
}

.save-btn {
  background: #4fc08d;
  color: white;
  border-radius: 50rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.save-btn::after {
  border: none;
}
